// AcidFlow settings. Comments and trailing commas are allowed.
// Changes take effect the next time the screensaver starts.
{
  "fps": 30,                // frame rate cap, 10..60 (lower = less GPU/CPU)
  "quality": 0.75,          // max render resolution, fraction of the screen, 0.35..1
  "speed": 1.0,             // global time multiplier (0.25 = meditative, 2 = energetic)

  "flow": 1.0,              // strength of the fluid motion
  "swirl": 1.0,             // global rotation
  "detail": 1.0,            // spatial scale (2 = smaller features, 0.5 = big soft blobs)
  "warp": 1.0,              // how much the pattern folds over itself
  "colorShift": 1.0,        // how fast hues drift through the palette
  "saturation": 1.0,
  "brightness": 1.0,
  "vignette": 1.0,          // 0 = off

  "paletteSeconds": 150,    // seconds each palette stays before morphing to the next
  "morphSeconds": 40,       // cross-fade length

  // Palettes to cycle through. [] = all built-in:
  //   "Prism", "Lava lamp", "Deep sea", "Sunset", "Neon", "Aurora", "Ultraviolet", "Ember",
  //   "Acid", "Miami", "Forest", "Mono ice"
  // Mix names with your own: { "name": "Mine", "colors": ["#ff0066", "#ffe600", "#00ff99", "#0066ff"] }
  // (2..16 hex colours, looped into a smooth gradient)
  "palettes": [],

  // Thin soap bubbles that well up out of the picture, rise slowly and fade or pop.
  // The rim bleeds into the fluid, so the flow carries ghost rings away and a pop leaves a burst behind.
  "bubbles": {
    "enabled": true,
    "count": 8,             // bubbles on screen at most (1..16)
    "everySeconds": 2.5,    // average seconds between new bubbles
    "size": 1.0,            // radius multiplier
    "life": 16,             // seconds a bubble lives (randomised 0.7x..1.3x)
    "rise": 1.0,            // upward drift speed
    "thickness": 1.0,       // rim thickness
    "opacity": 1.0,         // rim brightness in the picture (0 = no crisp rim, only the ink in the fluid)
    "lens": 1.0,            // refraction inside the bubble (0 = flat)
    "ink": 1.0,             // how strongly the rim bleeds into the fluid (0 = off)
    "pop": 0.5,             // share of bubbles that pop instead of fading out (0..1)
  },

  // Mystify-style line shapes that drift through the picture and bleed into the fluid (off by default since 1.3)
  "mystify": {
    "enabled": false,
    "shapes": 2,            // number of polygons (1..8)
    "points": 4,            // vertices per polygon (3..8)
    "speed": 1.0,           // movement speed
    "trail": 12,            // trailing copies (0 = none)
    "trailSpacing": 3,      // frames between trailing copies
    "lineWidth": 1.4,       // pixels at 1080p
    "opacity": 0.35,        // crisp overlay opacity (0 = no overlay, only the ink in the fluid)
    "ink": 1.0,             // how strongly the lines bleed into the fluid (0 = off)
  },

  // Eruptions: inverted drops. A soft dimple sinks into the picture, then a kaleidoscopic bloom wells up out of it.
  // Breakthroughs fold the whole screen kaleidoscopically for a few seconds. Off since 1.3.1 (bubbles only).
  "eruptions": {
    "enabled": false,
    "everySeconds": 10,     // average seconds between eruptions (randomised 0.5x..1.5x)
    "intensity": 1.0,       // size of the drop and strength of its ripple (0.2..3)
    "duration": 8,          // seconds a drop lives: bubble, plop, then the flow takes the colour apart
    "symmetry": 6,          // kaleidoscope folds in the bloom (0 = none, max 16)
    "breakthroughEverySeconds": 240,  // whole-screen kaleidoscope (0 = off)
    "breakthroughSeconds": 10,
    "takeoverEverySeconds": 240,      // a drop that swallows the whole picture and brings the next palette (0 = off)
    "takeoverSeconds": 12,
  },
}

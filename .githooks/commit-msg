#!/bin/sh
# exoit guard: the commit message is public too.
scanner=$(git config --get exoit.scanner)
if [ -z "$scanner" ]; then
  echo "exoit guard: git config exoit.scanner is not set. Run tools/Install-Guard.ps1." >&2
  exit 1
fi
exec pwsh -NoProfile -NonInteractive -File "$scanner" -TextFile "$1"
